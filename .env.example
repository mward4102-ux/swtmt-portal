# ─────────────────────────────────────────────────────────────────────────────
# Beach Stanton Insurance — environment configuration
#
# The app runs fully in DEMO MODE with NONE of these set. Every integration is
# wired behind the presence of its key (or an explicit flag), so going live is a
# "flip the switch" exercise, not a rewrite. Copy this file to `.env.local`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Demo mode ────────────────────────────────────────────────────────────────
# When DEMO_MODE=true (the default whenever Supabase is not configured), the app
# uses an in-memory store seeded with the 8 sample documents and never persists
# real PII. Set to "false" only once Supabase below is configured.
DEMO_MODE=true

# Secret used to sign session cookies. A dev default is used if unset.
AUTH_SECRET=

# ── Supabase (Postgres + Auth + Storage) ─────────────────────────────────────
# Provide all three to switch the data layer off the in-memory demo store.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # functions/server only — never exposed client-side

# ── Anthropic (AI extraction) ────────────────────────────────────────────────
# With no key set, known sample documents return their canonical extraction and
# unknown uploads return a clearly-labelled demo extraction. Set the key to run
# real Claude vision extraction on any uploaded document.
ANTHROPIC_API_KEY=                  # functions/server only
ANTHROPIC_EXTRACTION_MODEL=claude-sonnet-4-6
ANTHROPIC_CLASSIFY_MODEL=claude-haiku-4-5-20251001

# ── Scheduling (Cal.com) ─────────────────────────────────────────────────────
# Set NEXT_PUBLIC_CAL_LINK to embed the real Cal.com booking page; otherwise the
# built-in demo scheduler is used.
NEXT_PUBLIC_CAL_LINK=               # e.g. beachstanton/new-quote-consultation
CAL_WEBHOOK_SECRET=

# ── Email (Resend) ───────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Beach Stanton Insurance <hello@beachstanton.com>"
AGENT_ALERT_EMAIL=beach@beachstanton.com

# ── SMS (Twilio, optional) ───────────────────────────────────────────────────
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ── Compliance / PII gate ────────────────────────────────────────────────────
# When false (default), document binaries are deleted after extraction and no
# license numbers / DOB / full addresses persist beyond the active session.
PII_STORAGE_ENABLED=false
